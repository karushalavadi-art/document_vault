{
  "name": "document-vault",
  "version": "1.0.0",
  "private": true,
  "description": "Document Vault GraphQL API - Collections & Documents backend",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "gendb": "bunx prisma migrate deploy && bunx prisma generate",
    "migrate:dev": "bunx prisma migrate dev",
    "prisma:generate": "bunx prisma generate",
    "prisma:studio": "bunx prisma studio",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx eslint .",
    "sanity": "bun run lint && bun run typecheck && bun test"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "graphql": "^17.0.2",
    "graphql-scalars": "^2.0.0",
    "graphql-yoga": "^5.22.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.10",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.0",
    "prisma": "5.22.0",
    "typescript": "^5.6.3"
  }
}
